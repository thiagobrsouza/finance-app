# API
# Atenção: se a senha do Postgres tiver caracteres especiais (@, #, %, etc.), eles
# precisam ser URL-encoded (ex: "@" -> "%40"), senão a URL de conexão quebra.
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_app?schema=public"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Resend (e-mails transacionais: cadastro, MFA, reset de senha)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FinanceApp <no-reply@seudominio.com>"

# URL do frontend, usada para montar os links enviados por e-mail
FRONTEND_URL="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3333/api/v1"
